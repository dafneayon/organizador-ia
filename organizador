#!/bin/zsh
# Organizador IA: comando principal.
#   organizador ahora [carpeta ...]       -> organiza ahora (sin carpeta: Escritorio y Descargas)
#   organizador simulacro [carpeta ...]   -> muestra qué haría, sin mover nada
#   organizador programar <día> [HH:MM] [carpeta ...]        -> cada mes ese día (1-28)
#   organizador programar-una <AAAA-MM-DD> [HH:MM] [carpeta ...] -> una sola vez
#   organizador entrenar                  -> entrena el clasificador local con el historial
#   organizador indexar | buscar "texto" | preguntar "pregunta" | mcp-config  -> tus documentos
#   organizador estado | cancelar | deshacer | ayuda
#   Con carpeta: se organiza ESA carpeta en su propio lugar (las categorías se crean dentro).
set -e
DIR="${0:A:h}"
PLIST="$HOME/Library/LaunchAgents/com.organizador-ia.plist"
ETIQ="com.organizador-ia"
LOGS="$DIR/registro_local"
PROG_CARPETAS="$DIR/programacion_carpetas.txt"
mkdir -p "$LOGS"

buscar_claude() {
  if command -v claude >/dev/null 2>&1; then command -v claude; return; fi
  for c in "$HOME/.local/bin/claude" "$HOME/.claude/local/claude" /opt/homebrew/bin/claude /usr/local/bin/claude; do
    [[ -x "$c" ]] && { echo "$c"; return; }
  done
  # binario incluido en la extensión de VS Code (la versión más reciente)
  ls -d "$HOME"/.vscode/extensions/anthropic.claude-code-*/resources/native-binary/claude(N) 2>/dev/null | sort -V | tail -1
}

ejecutar() {
  local simulacro="$1" carpeta="$2"
  local CLAUDE="$(buscar_claude)"
  [[ -x "$CLAUDE" ]] || { echo "No encuentro 'claude'. Instálalo: curl -fsSL https://claude.ai/install.sh | bash"; exit 1; }
  local HERR="$DIR/herramienta.py"
  local PROMPT="$(/usr/bin/python3 -I -c '
import json,sys
d=sys.argv[1]
c=json.load(open(d+"/config.json"))["categorias"]
cats="\n".join("- %s | %s | %s" % (k, v["color"] or "sin color", v["ejemplos"]) for k,v in c.items())
print(open(d+"/instrucciones.md").read().replace("$CATEGORIAS", cats))' "$DIR")"
  PROMPT="$PROMPT

Ruta de la herramienta: /usr/bin/python3 $HERR
Ejemplo: /usr/bin/python3 $HERR listar --duplicados"
  [[ "$simulacro" == 1 ]] && PROMPT="$PROMPT

MODO SIMULACRO: la herramienta no moverá nada de verdad; actúa con normalidad para mostrar qué harías."
  if [[ -n "$carpeta" ]]; then
    export ORGANIZADOR_CARPETA="$carpeta"
    local extra_txt="$(<"$DIR/instrucciones_carpeta.md")"
    PROMPT="$PROMPT
${extra_txt//\$CARPETA/$carpeta}"
  else
    unset ORGANIZADOR_CARPETA
  fi

  export ORGANIZADOR_SIMULACRO="$simulacro"
  export ORGANIZADOR_AGENTE=1
  export ORGANIZADOR_EJECUCION="${ORGANIZADOR_EJECUCION:-$(date +%Y%m%d-%H%M%S)}"
  # Privacidad: sin memoria automática, sin telemetría ni reportes de errores
  export CLAUDE_CODE_DISABLE_AUTO_MEMORY=1
  export DISABLE_TELEMETRY=1 DISABLE_ERROR_REPORTING=1 CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

  echo "== Organizador IA $( [[ $simulacro == 1 ]] && echo '(SIMULACRO)') — ${carpeta:-Escritorio y Descargas} — $(date) =="
  cd "$DIR"
  # Clasificador local: mueve primero lo que decide con alta confianza (solo modo general)
  if [[ -z "$carpeta" ]] && auto_activado; then
    /usr/bin/python3 "$HERR" auto || true
    if [[ "$simulacro" == 1 ]]; then
      PROMPT="$PROMPT
Los elementos marcados [ALTA CONFIANZA] ya los movió el clasificador local (en simulacro siguen apareciendo): no los muevas ni los cuentes."
    elif /usr/bin/python3 "$HERR" listar | grep -q '^TOTAL: 0 elementos'; then
      echo "El clasificador local organizó todo; no hizo falta llamar al agente."
      echo "== Fin $(date) =="
      return
    fi
  fi
  # Solo tres herramientas: Read y Glob (lectura) y Bash limitado a la herramienta segura.
  # Sin Write/Edit, sin web, sin MCP, sin guardar la sesión en disco.
  "$CLAUDE" -p "$PROMPT" \
    --tools "Read,Glob,Bash" \
    --allowedTools "Read" "Glob" "Bash(/usr/bin/python3 $HERR:*)" \
    --disallowedTools "Write" "Edit" "NotebookEdit" "WebFetch" "WebSearch" "Bash(rm:*)" "Bash(mv:*)" "Bash(cp:*)" \
    --permission-mode dontAsk \
    --setting-sources "" \
    --strict-mcp-config \
    --no-session-persistence \
    --max-turns 200
  echo "== Fin $(date) =="
}

auto_activado() {
  /usr/bin/python3 -I -c '
import json,sys
c=json.load(open(sys.argv[1]+"/config.json")).get("clasificador",{})
sys.exit(0 if c.get("usar") and c.get("auto_mover") else 1)' "$DIR"
}

programar() {
  local dia="$1" hora="${2:-10:00}" mes="$3"
  local H="${hora%%:*}" M="${hora##*:}"
  [[ "$dia" -ge 1 && "$dia" -le 28 ]] || { echo "Día debe ser 1-28"; exit 1; }
  local CMD="$DIR/organizar.command"
  local extra=""
  [[ -n "$mes" ]] && extra="<key>Month</key><integer>$((10#$mes))</integer>"
  cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$ETIQ</string>
  <key>ProgramArguments</key><array><string>/usr/bin/open</string><string>-a</string><string>Terminal</string><string>$CMD</string></array>
  <key>StartCalendarInterval</key><dict>$extra<key>Day</key><integer>$((10#$dia))</integer><key>Hour</key><integer>$((10#$H))</integer><key>Minute</key><integer>$((10#$M))</integer></dict>
</dict></plist>
EOF
  launchctl bootout "gui/$(id -u)/$ETIQ" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$PLIST"
}

# Convierte las carpetas recibidas en rutas absolutas y comprueba que se pueden organizar
validar_carpetas() {
  CARPETAS=()
  local c abs
  for c in "$@"; do
    abs="${c:A}"
    [[ -d "$abs" ]] || { echo "No existe la carpeta: $c"; exit 1; }
    ORGANIZADOR_CARPETA="$abs" /usr/bin/python3 -I "$DIR/herramienta.py" validar >/dev/null || {
      ORGANIZADOR_CARPETA="$abs" /usr/bin/python3 -I "$DIR/herramienta.py" validar; exit 1; }
    CARPETAS+=("$abs")
  done
}

# Una ejecución completa: general o una sesión por cada carpeta (mismo id para 'deshacer')
ejecutar_todo() {
  local simulacro="$1"; shift
  export ORGANIZADOR_EJECUCION="$(date +%Y%m%d-%H%M%S)"
  if (( $# == 0 )); then ejecutar "$simulacro" ""
  else for c in "$@"; do ejecutar "$simulacro" "$c"; done; fi
}

# Separa [HH:MM] opcional de la lista de carpetas
leer_hora_y_carpetas() {
  HORA="10:00"
  if [[ "$1" =~ '^[0-9]{1,2}:[0-9]{2}$' ]]; then HORA="$1"; shift; fi
  validar_carpetas "$@"
}

guardar_carpetas() {
  : > "$PROG_CARPETAS"
  for c in "${CARPETAS[@]}"; do print -r -- "$c" >> "$PROG_CARPETAS"; done
}

describir() { (( ${#CARPETAS[@]} )) && print -r -- "${(j:, :)CARPETAS}" || echo "Escritorio y Descargas"; }

case "${1:-ayuda}" in
  ahora)      shift; validar_carpetas "$@"; ejecutar_todo 0 "${CARPETAS[@]}" 2>&1 | tee "$LOGS/ultima_ejecucion.txt" ;;
  simulacro)  shift; validar_carpetas "$@"; ejecutar_todo 1 "${CARPETAS[@]}" 2>&1 | tee "$LOGS/ultimo_simulacro.txt" ;;
  _programado)
    CARPETAS=(); [[ -s "$PROG_CARPETAS" ]] && CARPETAS=("${(@f)$(<"$PROG_CARPETAS")}")
    ejecutar_todo 0 "${CARPETAS[@]}" 2>&1 | tee "$LOGS/ultima_ejecucion.txt"
    [[ -f "$DIR/.una_vez" ]] && { rm -f "$DIR/.una_vez"; "$0" cancelar; } ;;
  programar)
    dia="${2:?Uso: organizador programar <día 1-28> [HH:MM] [carpeta ...]}"; shift 2
    leer_hora_y_carpetas "$@"
    rm -f "$DIR/.una_vez"
    programar "$dia" "$HORA"; guardar_carpetas
    echo "Listo: se organizará $(describir) el día $dia de cada mes a las $HORA. Se abrirá una ventana de Terminal." ;;
  programar-una)
    f="${2:?Uso: organizador programar-una AAAA-MM-DD [HH:MM] [carpeta ...]}"; shift 2
    leer_hora_y_carpetas "$@"
    touch "$DIR/.una_vez"
    programar "${f:8:2}" "$HORA" "${f:5:2}"; guardar_carpetas
    echo "Listo: se organizará $(describir) una vez el $f a las $HORA." ;;
  estado)
    if [[ -f "$PLIST" ]]; then
      echo "Programado:"; /usr/bin/plutil -extract StartCalendarInterval json -o - "$PLIST"; echo
      [[ -f "$DIR/.una_vez" ]] && echo "(una sola vez)" || echo "(cada mes)"
      if [[ -s "$PROG_CARPETAS" ]]; then echo "Carpetas:"; sed 's/^/  - /' "$PROG_CARPETAS"; else echo "Carpetas: Escritorio y Descargas"; fi
    else echo "No hay nada programado."; fi ;;
  cancelar)
    launchctl bootout "gui/$(id -u)/$ETIQ" 2>/dev/null || true
    rm -f "$PLIST" "$DIR/.una_vez" "$PROG_CARPETAS"; echo "Programación cancelada." ;;
  deshacer)   ORGANIZADOR_AGENTE=0 /usr/bin/python3 "$DIR/herramienta.py" deshacer ;;
  indexar|buscar|preguntar|mcp-config)
    PY="$DIR/.venv/bin/python"; [[ -x "$PY" ]] || PY=/usr/bin/python3   # sin .venv: solo palabras clave
    orden="$1"; shift
    case "$orden" in
      indexar)   "$PY" -W ignore "$DIR/busqueda.py" indexar "$@" ;;
      buscar)    "$PY" -W ignore "$DIR/busqueda.py" buscar "${1:?Uso: organizador buscar TEXTO}" "${@:2}" ;;
      preguntar)
        CLAUDE="$(buscar_claude)"
        [[ -x "$CLAUDE" ]] || { echo "No encuentro 'claude'."; exit 1; }
        "$PY" -W ignore "$DIR/busqueda.py" preguntar "${1:?Uso: organizador preguntar PREGUNTA}" --claude "$CLAUDE" ;;
      mcp-config)
        print -r -- "Agrega esto dentro de \"mcpServers\" en
~/Library/Application Support/Claude/claude_desktop_config.json y reinicia Claude Desktop:

    \"organizador\": {
      \"command\": \"$PY\",
      \"args\": [\"$DIR/mcp_servidor.py\"]
    }

O en Claude Code:
    claude mcp add organizador -- \"$PY\" \"$DIR/mcp_servidor.py\"" ;;
    esac ;;
  entrenar)
    [[ -x "$DIR/.venv/bin/python" ]] || {
      echo "Primero instala las dependencias de entrenamiento:"
      echo "  /usr/bin/python3 -m venv $DIR/.venv && $DIR/.venv/bin/pip install -r $DIR/requirements-entrenamiento.txt"
      exit 1; }
    "$DIR/.venv/bin/python" "$DIR/entrenar.py" ;;
  *) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
